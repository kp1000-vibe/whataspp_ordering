# ─── Database ───────────────────────────────────────────────────────────────
# Local dev with zero infrastructure (PGlite = real Postgres 16 compiled to WASM):
DATABASE_URL=pglite://.data/dev
# Tests use an ephemeral in-memory instance:
#   DATABASE_URL=pglite://memory
# Staging / production — any managed Postgres (Neon, Supabase, RDS):
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ─── Secrets ────────────────────────────────────────────────────────────────
# Required in production. Encrypts integration credentials at rest (AES-256-GCM).
ENCRYPTION_KEY=

# ─── AI provider ────────────────────────────────────────────────────────────
# deterministic | anthropic | openai
# "deterministic" is the offline rule-based driver: no key, no network, and it
# is what the whole test suite runs against.
AI_PROVIDER=deterministic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_MS=12000

# ─── Speech to text ─────────────────────────────────────────────────────────
# mock | openai   (mock resolves WhatsApp media ids against registered fixtures)
STT_PROVIDER=mock

# ─── WhatsApp Business Platform (Meta Cloud API) ────────────────────────────
# Leave blank to use the built-in simulator. Unofficial automation is never used.
MESSAGING_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ─── Background worker ──────────────────────────────────────────────────────
# Unset: the web process drains the queue inline (fine for one instance).
# "external": run `npm run worker` separately and the web process will not drain.
WORKER_MODE=
REDIS_URL=

# ─── Payments (interfaces only in V1 — pay at pickup) ───────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Misc ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_COUNTRY_CODE=91
LOG_LEVEL=info
